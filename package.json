{
  "name": "skinid-storefront",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run catalog:generate",
    "build": "vite build",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "test": "node --test tests/*.test.js",
    "test:all": "npm test && npm run build",
    "dev:ui": "vite --mode ui",
    "build:ui": "vite build --mode ui",
    "dev:api": "node scripts/dev/api-server.mjs",
    "check:config": "node scripts/backend/check-config.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wrangler": "^4.42.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}

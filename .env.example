# =====================================================
# SkinID — Environment Variables Template
# =====================================================
# SAO CHÉP file này thành .env và điền giá trị thật.
# File .env được gitignore — KHÔNG commit file .env lên GitHub.
# File này (.env.example) là an toàn để commit vì chứa tên biến, không có giá trị thật.

# ----- GEMINI AI -----
# API key từ Google AI Studio: https://aistudio.google.com/app/apikey
# Chỉ dùng trong Firebase Function hoặc server — KHÔNG đặt vào frontend JS
GEMINI_API_KEY=your_gemini_api_key_here

# ----- FIREBASE -----
# Lấy từ Firebase Console → Project Settings → General → Your apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ----- FIREBASE ADMIN (chỉ dùng server-side / Functions) -----
# Lấy từ Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Hoặc đặt GOOGLE_APPLICATION_CREDENTIALS trong môi trường hệ điều hành trỏ tới file JSON.
# Chỉ scripts/import-products-to-firestore.mjs được phép đọc credential này.

# ----- NETLIFY (deploy) -----
# Không cần đặt ở đây — đặt trực tiếp trong Netlify Dashboard → Site settings → Env vars
